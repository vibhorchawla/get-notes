# ── GetNotes Frontend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# All EXPO_PUBLIC_* variables are accessible in the app code.

# API Base URL (Expo dev server auto-detects this; set only for production)
EXPO_PUBLIC_API_BASE_URL=http://your-server-ip:5000/api

# Google OAuth (https://console.cloud.google.com/)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id

# Facebook Login (https://developers.facebook.com/)
EXPO_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=your_facebook_client_token
